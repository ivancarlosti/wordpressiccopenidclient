msgid "Discovery document is missing required fields: %s"
msgstr "El documento de descubrimiento no tiene campos obligatorios: %s"

#: includes/icc-openid-client-settings-page.php:824
msgid "Security check failed. Please try again."
msgstr "Verificación de seguridad falló. Por favor intente de nuevo."

#: includes/icc-openid-client-settings-page.php:868
#. translators: %d: number of fields populated
msgid ""
"Configuration loaded successfully! %d field was populated. Review the "
"settings below and click \"Save Changes\" to apply."
msgid_plural ""
