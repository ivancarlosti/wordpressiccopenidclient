#: includes/icc-openid-client-settings-page.php:895
msgid "Quick Setup: Import from Discovery Document"
msgstr "Configuración Rápida: Importar desde Documento de Descubrimiento"

#: includes/icc-openid-client-settings-page.php:899
msgid ""
"Auto-populate endpoint settings from your identity provider's OpenID "
"Connect discovery document. After loading, review the populated fields "
"below and click \"Save Changes\" to apply."
msgstr ""

#: includes/icc-openid-client-settings-page.php:907
msgid "Discovery URL"
msgstr "URL de Descubrimiento"

#: includes/icc-openid-client-settings-page.php:919
msgid "Enter your identity provider's OpenID Connect discovery endpoint URL."
msgstr "Ingrese la URL del endpoint de descubrimiento OpenID Connect de su proveedor de identidad."

