#: includes/icc-openid-client-settings-page.php:127
msgid "OpenID Connect - Generic Client"
msgstr "ICC OpenID Client"

#: includes/icc-openid-client-settings-page.php:128
msgid "OpenID Connect Client"
msgstr "ICC OpenID Client"

#: includes/icc-openid-client-settings-page.php:152
msgid "Client Settings"
msgstr "Configuración del Cliente"

#: includes/icc-openid-client-settings-page.php:159
msgid "WordPress User Settings"
msgstr "Configuración de Usuario WordPress"

#: includes/icc-openid-client-settings-page.php:166
msgid "Authorization Settings"
msgstr "Configuración de Autorización"

#: includes/icc-openid-client-settings-page.php:173
msgid "Log Settings"
msgstr "Configuración de Log"

#: includes/icc-openid-client-settings-page.php:231
msgid "Login Type"
msgstr "Tipo de Inicio de Sesión"

#: includes/icc-openid-client-settings-page.php:232
msgid "Select how the client (login form) should provide login options."
msgstr "Seleccione cómo el cliente (formulario de inicio de sesión) debe proporcionar opciones de inicio de sesión."

#: includes/icc-openid-client-settings-page.php:235
msgid "OpenID Connect button on login form"
msgstr "Botón OpenID Connect en el formulario de inicio de sesión"

#: includes/icc-openid-client-settings-page.php:236
msgid "Auto Login - SSO"
msgstr "Inicio de Sesión Automático - SSO"

#: includes/icc-openid-client-settings-page.php:242
msgid "Login Button Text"
msgstr "Texto del Botón de Inicio de Sesión"

#: includes/icc-openid-client-settings-page.php:243
msgid ""
"Customize the text shown on the OpenID Connect login button. Leave empty to "
"use the default text."
msgstr ""

#: includes/icc-openid-client-settings-page.php:249
msgid "Client ID"
msgstr "ID del Cliente"

#: includes/icc-openid-client-settings-page.php:250
msgid ""
"The ID this client will be recognized as when connecting the to Identity "
"provider server."
msgstr ""

#: includes/icc-openid-client-settings-page.php:257
msgid "Client Secret Key"
msgstr "Clave Secreta del Cliente"

#: includes/icc-openid-client-settings-page.php:258
msgid ""
"Arbitrary secret key the server expects from this client. Can be anything, "
"but should be very unique."
msgstr ""

#: includes/icc-openid-client-settings-page.php:264
msgid "OpenID Scope"
msgstr "Alcance OpenID"

#: includes/icc-openid-client-settings-page.php:265
msgid "Space separated list of scopes this client should access."
msgstr "Lista de alcances separados por espacios que este cliente debe acceder."

#: includes/icc-openid-client-settings-page.php:272
msgid "Login Endpoint URL"
msgstr "URL del Endpoint de Inicio de Sesión"

#: includes/icc-openid-client-settings-page.php:273
msgid "Identify provider authorization endpoint."
msgstr "Endpoint de autorización del proveedor de identidad."

#: includes/icc-openid-client-settings-page.php:280
msgid "Userinfo Endpoint URL"
msgstr "URL del Endpoint Userinfo"

#: includes/icc-openid-client-settings-page.php:281
msgid "Identify provider User information endpoint."
msgstr "Endpoint de información de usuario del proveedor de identidad."

#: includes/icc-openid-client-settings-page.php:288
msgid "Token Validation Endpoint URL"
msgstr "URL del Endpoint de Validación de Token"

#: includes/icc-openid-client-settings-page.php:289
msgid "Identify provider token endpoint."
msgstr "Endpoint de token del proveedor de identidad."

#: includes/icc-openid-client-settings-page.php:296
msgid "End Session Endpoint URL"
msgstr "URL del Endpoint de Cierre de Sesión"

#: includes/icc-openid-client-settings-page.php:297
msgid "Identify provider logout endpoint."
msgstr "Endpoint de cierre de sesión del proveedor de identidad."

#: includes/icc-openid-client-settings-page.php:304
msgid "JWKS URI"
msgstr "URI JWKS"

#: includes/icc-openid-client-settings-page.php:305
msgid ""
"Identity provider JWKS (JSON Web Key Set) endpoint for JWT signature "
"verification. Usually found at /.well-known/jwks.json"
msgstr ""

#: includes/icc-openid-client-settings-page.php:312
msgid "Issuer"
msgstr "Emisor"

#: includes/icc-openid-client-settings-page.php:313
msgid ""
"Identity provider issuer URL for JWT validation. If not set, the issuer "
"will be automatically derived from the Login Endpoint URL. Only configure "
"this if your IDP uses a different issuer than the base URL of the login "
"endpoint."
msgstr ""

#: includes/icc-openid-client-settings-page.php:320
msgid "JWKS Cache TTL (seconds)"
msgstr "TTL de Caché JWKS (segundos)"

#: includes/icc-openid-client-settings-page.php:321
msgid "Time in seconds to cache JWKS keys. Default: 3600 (1 hour)"
msgstr "Tiempo en segundos para almacenar en caché las claves JWKS. Predeterminado: 3600 (1 hora)"

#: includes/icc-openid-client-settings-page.php:327
msgid "ACR values"
msgstr "Valores ACR"

#: includes/icc-openid-client-settings-page.php:328
msgid "Use a specific defined authentication contract from the IDP - optional."
msgstr "Use un contrato de autenticación específico definido por el IDP - opcional."

#: includes/icc-openid-client-settings-page.php:334
msgid "Identity Key"
msgstr "Clave de Identidad"

#: includes/icc-openid-client-settings-page.php:335
msgid ""
"Where in the user claim array to find the user's identification data. "
"Possible standard values: preferred_username, name, or sub. If you're "
"having trouble, use \"sub\"."
msgstr ""

#: includes/icc-openid-client-settings-page.php:341
msgid "HTTP Request Timeout"
msgstr "Timeout de Solicitud HTTP"

#: includes/icc-openid-client-settings-page.php:342
msgid "Set the timeout for requests made to the IDP. Default value is 5."
msgstr "Establece el timeout para solicitudes hechas al IDP. Valor predeterminado es 5."

#: includes/icc-openid-client-settings-page.php:348
msgid "Enforce Privacy"
msgstr "Forzar Privacidad"

#: includes/icc-openid-client-settings-page.php:349
msgid "Require users be logged in to see the site."
msgstr "Requiere que los usuarios inicien sesión para ver el sitio."

#: includes/icc-openid-client-settings-page.php:355
msgid "Alternate Redirect URI"
msgstr "URI de Redireccionamiento Alternativa"

#: includes/icc-openid-client-settings-page.php:356
msgid ""
"Provide an alternative redirect route. Useful if your server is causing "
"issues with the default admin-ajax method. You must flush rewrite rules "
"after changing this setting. This can be done by saving the Permalinks "
"settings page."
msgstr ""

#: includes/icc-openid-client-settings-page.php:361
msgid "Nickname Key"
msgstr "Clave de Apodo"

#: includes/icc-openid-client-settings-page.php:362
msgid ""
"Where in the user claim array to find the user's nickname. Possible "
"standard values: preferred_username, name, or sub."
msgstr ""

#: includes/icc-openid-client-settings-page.php:368
msgid "Email Formatting"
msgstr "Formato de Email"

#: includes/icc-openid-client-settings-page.php:369
msgid ""
"String from which the user's email address is built. Specify \"{email}\" as "
"long as the user claim contains an email claim."
msgstr ""

#: includes/icc-openid-client-settings-page.php:375
msgid "Display Name Formatting"
msgstr "Formato del Nombre para Mostrar"

#: includes/icc-openid-client-settings-page.php:376
msgid "String from which the user's display name is built."
msgstr "Cadena desde la cual se construye el nombre para mostrar del usuario."

#: includes/icc-openid-client-settings-page.php:382
msgid "Identify with User Name"
msgstr "Identificar por Nombre de Usuario"

#: includes/icc-openid-client-settings-page.php:383
msgid ""
"If checked, the user's identity will be determined by the user name instead "
"of the email address."
msgstr ""

#: includes/icc-openid-client-settings-page.php:388
msgid "State time limit"
msgstr "Límite de tiempo del estado"

#: includes/icc-openid-client-settings-page.php:389
msgid "State valid time in seconds. Defaults to 180"
msgstr "Tiempo de validez del estado en segundos. Predeterminado: 180"

#: includes/icc-openid-client-settings-page.php:394
msgid "Enable Refresh Token"
msgstr "Habilitar Token de Actualización"

#: includes/icc-openid-client-settings-page.php:395
msgid ""
"If checked, support refresh tokens used to obtain access tokens from "
"supported IDPs."
msgstr ""

#: includes/icc-openid-client-settings-page.php:400
msgid "Disable SSL Verify"
msgstr "Deshabilitar Verificación SSL"

#: includes/icc-openid-client-settings-page.php:402
#. translators: %1$s HTML tags for layout/styles (strong tag start with warning
#. class), %2$s closing HTML tag for styles.
msgid ""
"Do not require SSL verification during authorization. %1$sOnly works in "
"local development (WP_DEBUG=true, WP_ENVIRONMENT_TYPE=local).%2$s This "
"setting is automatically disabled in production. If you need this in "
"production, fix your SSL certificates instead."
msgstr ""

#: includes/icc-openid-client-settings-page.php:407
msgid "Allow Internal IDP"
msgstr "Permitir IDP Interno"

#: includes/icc-openid-client-settings-page.php:409
#. translators: %1$s HTML tags for layout/styles (strong tag start with warning
#. class), %2$s closing HTML tag for styles.
msgid ""
"Allow HTTP requests to internal/private network endpoints (localhost, "
"127.0.0.1, 10.x.x.x, 192.168.x.x, 172.16-31.x.x). %1$sOnly enable this for "
"local development or corporate internal identity providers. Disabling SSRF "
"protection can expose your server to security risks.%2$s"
msgstr ""

#: includes/icc-openid-client-settings-page.php:414
msgid "Link Existing Users"
msgstr "Vincular Usuarios Existentes"

#: includes/icc-openid-client-settings-page.php:415
msgid ""
"If a WordPress account already exists with the same identity as a "
"newly-authenticated user over OpenID Connect, login as that user instead of "
"generating an error."
msgstr ""

#: includes/icc-openid-client-settings-page.php:421
msgid "Create user if does not exist"
msgstr "Crear usuario si no existe"

#: includes/icc-openid-client-settings-page.php:422
msgid ""
"If the user identity is not linked to an existing WordPress user, it is "
"created. If this setting is not enabled, and if the user authenticates with "
"an account which is not linked to an existing WordPress user, then the "
"authentication will fail."
msgstr ""

#: includes/icc-openid-client-settings-page.php:428
msgid "Redirect Back to Origin Page"
msgstr "Redirigir de Vuelta a la Página de Origen"

#: includes/icc-openid-client-settings-page.php:429
msgid ""
"After a successful OpenID Connect authentication, this will redirect the "
"user back to the page on which they clicked the OpenID Connect login "
"button. This will cause the login process to proceed in a traditional "
"WordPress fashion. For example, users logging in through the default "
"wp-login.php page would end up on the WordPress Dashboard and users logging "
"in through the WooCommerce \"My Account\" page would end up on their "
"account page."
msgstr ""

#: includes/icc-openid-client-settings-page.php:435
msgid "Redirect to the login screen when session is expired"
msgstr "Redirigir a la pantalla de inicio de sesión cuando la sesión expire"

#: includes/icc-openid-client-settings-page.php:436
msgid ""
"When enabled, this will automatically redirect the user back to the "
"WordPress login page if their access token has expired."
msgstr ""

#: includes/icc-openid-client-settings-page.php:442
msgid "Enable Logging"
msgstr "Habilitar Registro"

#: includes/icc-openid-client-settings-page.php:443
msgid "Very simple log messages for debugging purposes."
msgstr "Mensajes de registro muy simples para fines de depuración."

#: includes/icc-openid-client-settings-page.php:449
msgid "Log Limit"
msgstr "Límite de Registro"

#: includes/icc-openid-client-settings-page.php:450
msgid ""
"Number of items to keep in the log. These logs are stored as an option in "
"the database, so space is limited."
msgstr ""

#: includes/icc-openid-client-settings-page.php:515
msgid "Notes"
msgstr "Notas"

#: includes/icc-openid-client-settings-page.php:518
msgid "Redirect URI"
msgstr "URI de Redireccionamiento"

#: includes/icc-openid-client-settings-page.php:522
msgid "Login Button Shortcode"
msgstr "Shortcode del Botón de Inicio de Sesión"

#: includes/icc-openid-client-settings-page.php:526
msgid "Authentication URL Shortcode"
msgstr "Shortcode de la URL de Autenticación"

#: includes/icc-openid-client-settings-page.php:531
msgid "Logs"
msgstr "Registros"

#: includes/icc-openid-client-settings-page.php:620
msgid "Example"
msgstr ""

