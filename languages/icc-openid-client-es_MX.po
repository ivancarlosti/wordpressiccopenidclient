msgid "Failed to fetch discovery document: %s"
msgstr "Falló la obtención del documento de descubrimiento: %s"

#: includes/icc-openid-client-settings-page.php:727
#. translators: %d: HTTP status code
msgid "Discovery document request returned HTTP %d."
msgstr "La solicitud del documento de descubrimiento devolvió HTTP %d."

#: includes/icc-openid-client-settings-page.php:740
msgid "Discovery document is not valid JSON."
msgstr "El documento de descubrimiento no es un JSON válido."

#: includes/icc-openid-client-settings-page.php:759
