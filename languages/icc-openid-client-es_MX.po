msgid "Invalid discovery URL format."
msgstr "Formato de URL de descubrimiento inválido."

#: includes/icc-openid-client-settings-page.php:695
msgid "Discovery URL must use HTTPS in production environments."
msgstr "La URL de descubrimiento debe usar HTTPS en entornos de producción."

#: includes/icc-openid-client-settings-page.php:715
