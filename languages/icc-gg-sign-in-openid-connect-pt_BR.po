msgstr "Erro do provedor de identidade %1$s: %2$s"

#: includes/icc-gg-sign-in-openid-connect-client.php:265
msgid "No authentication code present in the request."
msgstr "Nenhum código de autenticação presente na solicitação."

#: includes/icc-gg-sign-in-openid-connect-client.php:271
msgid "Missing state."
msgstr "Estado ausente."

#: includes/icc-gg-sign-in-openid-connect-client.php:275
msgid "Invalid state."
msgstr "Estado inválido."

#: includes/icc-gg-sign-in-openid-connect-client.php:290
msgid "Missing authentication code."
msgstr "Código de autenticação ausente."

#: includes/icc-gg-sign-in-openid-connect-client.php:335
msgid "Request for authentication token failed."
msgstr "A solicitação do token de autenticação falhou."

#: includes/icc-gg-sign-in-openid-connect-client.php:368
msgid "Refresh token failed."
msgstr "Falha ao atualizar o token."

#: includes/icc-gg-sign-in-openid-connect-client.php:383
msgid "Missing token body."
msgstr "Corpo do token ausente."

#: includes/icc-gg-sign-in-openid-connect-client.php:391
msgid "Invalid token."
msgstr "Token inválido."

#: includes/icc-gg-sign-in-openid-connect-client.php:452
msgid "Request for userinfo failed."
msgstr "A solicitação das informações do usuário falhou."

#: includes/icc-gg-sign-in-openid-connect-client.php:516
msgid "Missing authentication state."
msgstr "Estado de autenticação ausente."

#: includes/icc-gg-sign-in-openid-connect-client.php:537
msgid "Invalid token response."
msgstr "Resposta de token inválida."

#: includes/icc-gg-sign-in-openid-connect-client.php:553
msgid "No identity token."
msgstr "Nenhum token de identidade."

#: includes/icc-gg-sign-in-openid-connect-client.php:593
msgid "Missing identity token."
msgstr "Token de identidade ausente."

#: includes/icc-gg-sign-in-openid-connect-client.php:652
msgid "Bad ID token claim."
msgstr "Declaração do token de ID inválida."

#: includes/icc-gg-sign-in-openid-connect-client.php:657
msgid "No subject identity."
msgstr "Nenhuma identidade de assunto."

#: includes/icc-gg-sign-in-openid-connect-client.php:662 includes/icc-gg-sign-in-openid-connect-jwt-validator.php:184
msgid "Token missing expiration claim."
msgstr "O token não contém a declaração de expiração."

#: includes/icc-gg-sign-in-openid-connect-client.php:665
msgid "Token has expired."
msgstr "O token expirou."

#: includes/icc-gg-sign-in-openid-connect-client.php:670 includes/icc-gg-sign-in-openid-connect-jwt-validator.php:192
msgid "Token missing issued at claim."
msgstr "O token não contém a declaração de emissão (iat)."

#: includes/icc-gg-sign-in-openid-connect-client.php:675 includes/icc-gg-sign-in-openid-connect-jwt-validator.php:200
msgid "Token missing audience claim."
msgstr "O token não contém a declaração de público-alvo (aud)."

#: includes/icc-gg-sign-in-openid-connect-client.php:688 includes/icc-gg-sign-in-openid-connect-jwt-validator.php:217
msgid "Token audience does not match client."
msgstr "O público-alvo do token não corresponde ao cliente."

#: includes/icc-gg-sign-in-openid-connect-client.php:698 includes/icc-gg-sign-in-openid-connect-jwt-validator.php:226
msgid "Token missing issuer claim."
msgstr "O token não contém a declaração de emissor (iss)."

#. translators: 1: expected issuer URL, 2: issuer URL received in the token.
#: includes/icc-gg-sign-in-openid-connect-client.php:705 includes/icc-gg-sign-in-openid-connect-jwt-validator.php:234
#, php-format
msgid ""
"Issuer mismatch - Expected: \"%1$s\", Received: \"%2$s\". Configure the correct "
"issuer in Settings > ICC.gg Sign-In for OpenID Connect > Issuer field, or "
"via the OIDC_ISSUER constant."
msgstr ""
"Incompatibilidade de emissor - Esperado: \"%1$s\", Recebido: \"%2$s\". "
"Configure o emissor correto em Configurações > ICC.gg Sign-In for OpenID "
"Connect > campo Issuer, ou pela constante OIDC_ISSUER."

#: includes/icc-gg-sign-in-openid-connect-client.php:714
msgid ""
"Token issuer does not match expected issuer. Configure the correct issuer "
"in Settings > ICC.gg Sign-In for OpenID Connect > Issuer field, or via the "
"OIDC_ISSUER constant."
msgstr ""
"O emissor do token não corresponde ao emissor esperado. Configure o "
"emissor correto em Configurações > ICC.gg Sign-In for OpenID Connect > "
"campo Issuer, ou pela constante OIDC_ISSUER."

#: includes/icc-gg-sign-in-openid-connect-client.php:724
msgid "No matching acr values."
msgstr "Nenhum valor de acr correspondente."

#: includes/icc-gg-sign-in-openid-connect-client.php:744
msgid "Bad user claim."
msgstr "Declaração de usuário inválida."

#: includes/icc-gg-sign-in-openid-connect-client.php:764
msgid "Invalid user claim."
msgstr "Declaração de usuário inválida."

#: includes/icc-gg-sign-in-openid-connect-client.php:769
msgid "Error from the IDP."
msgstr "Erro do provedor de identidade."

#: includes/icc-gg-sign-in-openid-connect-client.php:778
msgid "Incorrect user claim."
msgstr "Declaração de usuário incorreta."

#: includes/icc-gg-sign-in-openid-connect-client.php:785
msgid "Unauthorized access."
msgstr "Acesso não autorizado."

#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:599
msgid "User identity is not linked to an existing WordPress user."
msgstr ""
"A identidade do usuário não está vinculada a um usuário WordPress "
"existente."

#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:660
msgid "Invalid user."
msgstr "Usuário inválido."

#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:692
msgid "Unable to determine email address from user claim for domain validation."
msgstr ""
"Não foi possível determinar o endereço de e-mail a partir da "
"declaração do usuário para validação de domínio."

#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:706
msgid "Unable to extract domain from email address."
msgstr "Não foi possível extrair o domínio do endereço de e-mail."

#. translators: %s is the email address or domain that was rejected
#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:748
#, php-format
msgid ""
"Email \"%s\" is not allowed for login. Check the allowed email or domain "
"restrictions."
msgstr ""
"O e-mail \"%s\" não é permitido para login. Verifique as restrições de "
"e-mail ou domínio permitidos."

#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:949
msgid "No appropriate username found."
msgstr "Nenhum nome de usuário apropriado encontrado."

#. translators: %1$s is the santitized version of the username from the IDP.
#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:959
#, php-format
msgid "Username %1$s could not be sanitized."
msgstr "Não foi possível sanitizar o nome de usuário %1$s."

#. translators: %1$s is the configured User Claim nickname key.
#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:981
#, php-format
msgid "No nickname found in user claim using key: %1$s."
msgstr "Nenhum apelido encontrado na declaração do usuário usando a chave: %1$s."

#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:1113
msgid "User claim incomplete."
msgstr "Declaração de usuário incompleta."

#. translators: %s is the claim key that is missing from the user claim.
#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:1117
#, php-format
msgid "Unable to find key: %s in user_claim"
msgstr "Não foi possível encontrar a chave: %s em user_claim"

#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:1120
msgid "Verify OpenID Scope includes a scope with the attributes you need"
msgstr "Verifique se o escopo OpenID inclui um escopo com os atributos necessários"

#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:1220
msgid "Bad user claim result."
msgstr "Resultado inválido da declaração de usuário."

#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:1286
msgid "Can not authorize."
msgstr "Não é possível autorizar."

#: includes/icc-gg-sign-in-openid-connect-client-wrapper.php:1315
msgid "Failed user creation."
msgstr "Falha na criação do usuário."

#: includes/icc-gg-sign-in-openid-connect-jwt-validator.php:127
msgid "Failed to fetch JWKS from identity provider."
msgstr "Falha ao obter o JWKS do provedor de identidade."

#. translators: %d is the HTTP response code
#: includes/icc-gg-sign-in-openid-connect-jwt-validator.php:138
#, php-format
msgid "JWKS endpoint returned HTTP %d"
msgstr "O endpoint JWKS retornou HTTP %d"

#: includes/icc-gg-sign-in-openid-connect-jwt-validator.php:152
msgid "Invalid JWKS format received from identity provider."
msgstr "Formato JWKS inválido recebido do provedor de identidade."

#: includes/icc-gg-sign-in-openid-connect-jwt-validator.php:176
msgid "Token missing subject claim."
msgstr "O token não contém a declaração de assunto (sub)."

#: includes/icc-gg-sign-in-openid-connect-jwt-validator.php:242
msgid "Token issuer does not match expected issuer."
msgstr "O emissor do token não corresponde ao emissor esperado."

#: includes/icc-gg-sign-in-openid-connect-jwt-validator.php:316
msgid "JWKS URI not configured. JWT signature verification requires JWKS endpoint."
msgstr ""
"URI do JWKS não configurada. A verificação de assinatura JWT requer o "
"endpoint JWKS."

#. translators: %s is the error message
#: includes/icc-gg-sign-in-openid-connect-jwt-validator.php:347
#, php-format
msgid "JWT verification failed: %s"
msgstr "Falha na verificação do JWT: %s"

#: includes/icc-gg-sign-in-openid-connect-login-form.php:132
msgid "Unknown error."
msgstr "Erro desconhecido."

