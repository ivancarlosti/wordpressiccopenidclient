<?xml version="1.0"?>
<ruleset name="ICC OpenID Client">
	<description>PHPCS rules for ICC OpenID Client WordPress plugin.</description>

	<!-- Include WordPress Coding Standards as the base -->
	<rule ref="WordPress"/>

	<!--
		PrefixAllGlobals: Define the plugin's recognized prefixes.
		WPCS auto-detects "icc_openid_client" (underscores) from the plugin name
		"ICC OpenID Client", but our hooks use hyphens: "icc-openid-client-*".
		This overrides the auto-detection to accept the hyphenated form used in
		all action/filter hook names throughout the plugin.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="icc-openid-client"/>
			</property>
		</properties>
	</rule>
</ruleset>
